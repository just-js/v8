# Minimal-size experiment, linux/x64 only (2026-08-27, branch
# v8-minimal-linux-x64) - see V8-BUILD-OPTS.md §9/§10 in the main repo for
# the full reasoning and the raw-archive size evidence (WASM 9.26MB/57
# files, Maglev 10.16MB/27 files, TurboFan partial 8.44MB/26 files,
# Sparkplug 0.27MB/3 files out of a 91.4MB total archive) that motivated
# this. First pass used v8_enable_lite_mode=true (cuts sparkplug/maglev/
# turbofan together, confirmed against real BUILD.gn ~line 4725-4745),
# real confirmed archive: 103.6MB -> 35.5MB. Switched 2026-08-27 to
# picking just one JIT tier back on instead of full jitless - real,
# build-enforced constraint found first: BUILD.gn has
# `assert(v8_enable_turbofan || !v8_enable_maglev, "Maglev is not
# available when Turbofan is disabled.")` - Maglev cannot exist without
# Turbofan, so "Maglev only" isn't actually an option; picking Maglev
# means paying for Turbofan too (the two biggest tiers combined).
# Sparkplug has no such coupling (gated purely on `!v8_jitless` in
# gni/v8.gni) and is by far the smallest of the three (0.27MB vs
# Maglev's 10.16MB) - the only tier that can genuinely stand alone.
# v8_enable_lite_mode dropped entirely (not just set false) rather than
# explicitly overridden - real, checked side effect if it were merely
# flipped to false: `v8_enable_webassembly = !v8_enable_lite_mode` and
# `v8_enable_turbofan = !v8_enable_lite_mode` are both real default
# cascades in gni/v8.gni (verified against the real file, full text
# searched, no other flag depends on lite_mode/jitless at the GN/build
# level) - both explicitly re-pinned below regardless, so this doesn't
# matter in practice, just noting it was checked, not assumed.
# use_thin_lto stays off - real, confirmed failure last run (cross-LLVM-
# version bitcode incompatibility, "Not an int attribute", see
# V8-BUILD-OPTS.md §10), not revisited here.
v8_enable_webassembly=false
v8_enable_turbofan=false
v8_enable_maglev=false
v8_enable_sparkplug=true
use_thin_lto=false
v8_advanced_bigint_algorithms=false
# cppgc's own caged heap is a separate reservation from v8_enable_sandbox/
# v8_enable_pointer_compression above (both already off) - it defaults on
# for every 64bit arch regardless, and with pointer compression + the
# larger-cage variant, reserves a 16GB PROT_NONE region at V8::Initialize()
# time, unconditionally, even though lo never creates a CppHeap (checked:
# no CppHeap/cppgc:: references anywhere in lo.cc/lo.h). Confirmed safe to
# disable directly against V8's own BUILD.gn: no assert blocks turning
# this off on 64bit (the only assert guards the reverse, 32bit), and
# cppgc_enable_pointer_compression only turns on inside the
# `if (cppgc_enable_caged_heap)` block, so it cleanly follows. Real-world
# validated too: Node v22.19.0 (musl x64, same environment shape as this
# build) runs with no such reservation at all.
cppgc_enable_caged_heap=false
cppgc_enable_pointer_compression=false
# v8_enable_partition_alloc defaults to true once
# v8_enable_pointer_compression_shared_cage is true (which itself
# defaults to mirroring v8_enable_pointer_compression above) - pulls in
# third_party/partition_alloc, whose safe_strerror.cc/stack_trace_posix.cc
# reference glibc-only symbols (__strncat_chk, __memmove_chk, pread64)
# that musl doesn't provide - real local link failure under
# MUSL=1 ./rebuild.sh. Not something we were trying to change - pin off
# explicitly, same as the mac args files (real CI failure there:
# run 32610257944, partition_alloc's allocator shim vs. Xcode SDK).
v8_enable_partition_alloc=false
