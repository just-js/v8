clang_use_chrome_plugins=false
dcheck_always_on=false
enable_rust=false
is_clang=true
is_component_build=false
is_debug=false
strip_debug_info=true
symbol_level=0
target_cpu="arm64"
target_os="linux"
treat_warnings_as_errors=false
use_custom_libcxx=false
use_rtti=false
use_sysroot=false
v8_deprecation_warnings=false
v8_enable_builtins_optimization=true
v8_enable_gdbjit=false
v8_enable_i18n_support=false
v8_enable_pointer_compression=true
v8_enable_sandbox=false
v8_enable_snapshot_compression=false
v8_enable_temporal_support=false
v8_enable_test_features=false
v8_imminent_deprecation_warnings=false
v8_monolithic=true
v8_target_cpu="arm64"
v8_use_external_startup_data=false
v8_enable_backtrace = false
# cppgc's own caged heap is a separate reservation from
# v8_enable_sandbox/v8_enable_pointer_compression above - defaults on
# for every 64bit arch regardless, reserving 16GB of PROT_NONE virtual
# address space at V8::Initialize() time unconditionally. lo never
# creates a CppHeap, so this is pure unused overhead. Full rationale:
# args.linux.x64.gn.
cppgc_enable_caged_heap=false
cppgc_enable_pointer_compression=false
# v8_enable_partition_alloc defaults to true once
# v8_enable_pointer_compression_shared_cage is true (which itself
# defaults to mirroring v8_enable_pointer_compression above) - pulls in
# third_party/partition_alloc, whose safe_strerror.cc/stack_trace_posix.cc
# reference glibc-only symbols (__strncat_chk, __memmove_chk, pread64)
# that musl doesn't provide - real local link failure under
# MUSL=1 ./rebuild.sh. Not something we were trying to change - pin off
# explicitly, same as the mac args files (real CI failure there:
# run 32610257944, partition_alloc's allocator shim vs. Xcode SDK).
v8_enable_partition_alloc=false
