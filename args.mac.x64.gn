clang_use_chrome_plugins=false
dcheck_always_on=false
enable_rust=false
is_cfi=false
is_asan=false
is_clang=true
is_component_build=false
is_debug=false
strip_debug_info=true
symbol_level=0
target_cpu="x64"
target_os="mac"
treat_warnings_as_errors=false
use_custom_libcxx=false
use_rtti=false
use_sysroot=false
v8_deprecation_warnings=false
v8_enable_temporal_support=false
v8_imminent_deprecation_warnings=false
v8_monolithic=true
v8_target_cpu="x64"
v8_use_external_startup_data=false
v8_enable_gdbjit=false
v8_enable_i18n_support=false
v8_enable_pointer_compression=true
v8_enable_sandbox=false
v8_enable_test_features=false
# SDK version is pinned via DEVELOPER_DIR in build.yml's build-mac job,
# not here - setting mac_sdk_path directly makes GN treat it as a raw
# absolute path outside root_build_dir, which build/config/mac/BUILD.gn's
# sdk_inputs action rejects as of the build.git pin V8 15.1 uses
# ("File is not inside output directory"). Leaving this unset lets
# mac_sdk.gni's own resolution + symlink-into-root_build_dir logic run
# as intended. Full writeup: V8-MAC.md.
v8_enable_backtrace = false
# cppgc's own caged heap is a separate reservation from
# v8_enable_sandbox/v8_enable_pointer_compression above - defaults on
# for every 64bit arch regardless, reserving 16GB of PROT_NONE virtual
# address space at V8::Initialize() time unconditionally. lo never
# creates a CppHeap, so this is pure unused overhead. Full rationale:
# args.linux.x64.gn.
cppgc_enable_caged_heap=false
cppgc_enable_pointer_compression=false
# v8_enable_partition_alloc defaults to true once
# v8_enable_pointer_compression_shared_cage is true (which itself
# defaults to mirroring v8_enable_pointer_compression above) - pulls in
# third_party/partition_alloc's allocator shim, whose
# -fvisibility-global-new-delete=force-hidden conflicts with Xcode
# 16.4/MacOSX15.5 SDK's own operator new/delete visibility declarations
# in <new> (real CI failure: run 32610257944, "visibility does not
# match previous declaration" compiling
# partition_alloc/shim/allocator_shim_dispatch_to_noop_on_free.cc).
# Not something we were trying to change - pin off explicitly to keep
# pointer compression itself on without pulling this in.
v8_enable_partition_alloc=false
